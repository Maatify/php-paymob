{
  "name": "maatify/paymob-php",
  "description": "PHP SDK for Paymob APIs (Egypt) – reference: https://developers.paymob.com/egypt/ . Supports Auth, Orders, Transactions, and Kiosk payments.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Maatify\\Paymob\\": "src/"
    }
  },
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "ext-json": "*",
    "ext-curl": "*",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "ext-pdo": "*",
    "phpunit/phpunit": "^11.5",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.6",
    "guzzlehttp/guzzle": "^7.0"
  }
}
